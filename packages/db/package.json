{
  "name": "@niveshbook/db",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@niveshbook/core": "workspace:*",
    "@niveshbook/types": "workspace:*",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9",
    "uuidv7": "^1.2.1"
  },
  "devDependencies": {
    "@niveshbook/config": "workspace:*",
    "@types/node": "^22.7.5",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
