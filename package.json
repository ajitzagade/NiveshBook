{
  "name": "niveshbook",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint && pnpm lint:boundaries",
    "lint:boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "audit": "pnpm audit",
    "test": "turbo run test",
    "e2e": "pnpm --filter web e2e",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "pnpm --filter @niveshbook/db db:migrate"
  },
  "devDependencies": {
    "dependency-cruiser": "^18.4.0",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
