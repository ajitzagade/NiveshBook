# Copy to .env for local dev/test (docker-compose.yml) or .env.local for
# apps/web. Same Postgres wire protocol locally and on Neon — only this
# value changes at deploy time (AD-7).
DATABASE_URL=postgres://niveshbook:niveshbook_dev@localhost:5433/niveshbook

# Per-client configuration (AD-7), resolved once in apps/web/lib/client-config.ts.
# A fresh deployment's branding, currency/locale, and enabled modules come
# entirely from these — no file branches on a client identifier. Any unset
# or malformed value falls back to its default below.
CLIENT_APP_NAME=NiveshBook
CLIENT_LOCALE=en-IN
CLIENT_CURRENCY=INR
# Project Admin ships disabled by default per client; only the literal
# string "true" enables it — any other value (including unset) is disabled.
CLIENT_ENABLE_PROJECT_ADMIN=false
